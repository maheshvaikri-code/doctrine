{
  "openapi": "3.1.0",
  "info": {
    "title": "Doctrine Local Operations Bridge",
    "version": "1.0.0",
    "description": "Loopback-only adapter from Doctrine repository authority to WorkHawk and compatible local clients."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Bridge is accepting requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/snapshot": {
      "get": {
        "operationId": "getSnapshot",
        "responses": {
          "200": {
            "description": "Current bounded repository control snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/verifications/current": {
      "get": {
        "operationId": "getCurrentVerification",
        "responses": {
          "200": {
            "description": "Current or most recent verification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verification"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/verifications": {
      "post": {
        "operationId": "startVerification",
        "description": "Starts the fixed Doctrine verifier for a clean worktree. At most one run may be active.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Verification accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verification"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "Stable error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "service",
          "status"
        ],
        "properties": {
          "apiVersion": {
            "const": "1"
          },
          "service": {
            "const": "doctrine-control-room-bridge"
          },
          "status": {
            "const": "ok"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "generatedAt",
          "partialReasons",
          "repository",
          "activation",
          "statePlane",
          "verification",
          "evidence",
          "release"
        ],
        "properties": {
          "apiVersion": {
            "const": "1"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "partialReasons": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 240
            }
          },
          "repository": {
            "$ref": "#/components/schemas/Repository"
          },
          "activation": {
            "$ref": "#/components/schemas/Activation"
          },
          "statePlane": {
            "$ref": "#/components/schemas/StatePlane"
          },
          "verification": {
            "$ref": "#/components/schemas/Verification"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "release": {
            "$ref": "#/components/schemas/Release"
          }
        }
      },
      "Repository": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connected",
          "name",
          "version",
          "branch",
          "commit",
          "isDirty",
          "trackedFiles"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "isDirty": {
            "type": "boolean"
          },
          "trackedFiles": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Activation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "passing",
          "total",
          "findings"
        ],
        "properties": {
          "status": {
            "enum": [
              "healthy",
              "degraded"
            ]
          },
          "passing": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivationFinding"
            }
          }
        }
      },
      "ActivationFinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "enum": [
              "pass",
              "warning",
              "failed"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "StatePlane": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "checkpointSeq",
          "checkpointCommit",
          "checkpoints",
          "unresolvedEffects",
          "role",
          "phase"
        ],
        "properties": {
          "status": {
            "enum": [
              "healthy",
              "degraded",
              "missing"
            ]
          },
          "checkpointSeq": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "checkpointCommit": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkpoints": {
            "type": "integer",
            "minimum": 0
          },
          "unresolvedEffects": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "commit",
          "startedAt",
          "finishedAt",
          "exitCode",
          "testCount",
          "summary",
          "gates"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "never_run",
              "running",
              "passed",
              "failed",
              "timed_out"
            ]
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "testCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "maxLength": 240
          },
          "gates": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Gate"
            }
          }
        }
      },
      "Gate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "status",
          "evidence"
        ],
        "properties": {
          "key": {
            "enum": [
              "lint",
              "ruff",
              "tests",
              "state"
            ]
          },
          "label": {
            "type": "string"
          },
          "status": {
            "enum": [
              "unknown",
              "running",
              "passed",
              "failed"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 160
          }
        }
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviews",
          "qaReports",
          "adrs",
          "plans",
          "goldRecords",
          "trend",
          "activity"
        ],
        "properties": {
          "reviews": {
            "type": "integer",
            "minimum": 0
          },
          "qaReports": {
            "type": "integer",
            "minimum": 0
          },
          "adrs": {
            "type": "integer",
            "minimum": 0
          },
          "plans": {
            "type": "integer",
            "minimum": 0
          },
          "goldRecords": {
            "type": "integer",
            "minimum": 0
          },
          "trend": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "7D",
              "30D",
              "90D"
            ],
            "properties": {
              "7D": {
                "$ref": "#/components/schemas/IntegerSeries"
              },
              "30D": {
                "$ref": "#/components/schemas/IntegerSeries"
              },
              "90D": {
                "$ref": "#/components/schemas/IntegerSeries"
              }
            }
          },
          "activity": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/Activity"
            }
          }
        }
      },
      "IntegerSeries": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "Activity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "occurredAt",
          "title"
        ],
        "properties": {
          "commit": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Release": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currentVersion",
          "latestTag",
          "commitsAhead",
          "status"
        ],
        "properties": {
          "currentVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "latestTag": {
            "type": [
              "string",
              "null"
            ]
          },
          "commitsAhead": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "enum": [
              "current",
              "ahead",
              "unreleased"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
