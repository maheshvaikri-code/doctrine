{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR',''),'tools','doctrine_state.py'); sys.exit(subprocess.call([sys.executable,p,'hydrate','--if-present']) if os.path.exists(p) else 0)\""
          },
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR',''),'tools','doctrine_metrics.py'); sys.exit(subprocess.call([sys.executable,p,'capture-hint']) if os.path.exists(p) else 0)\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR',''),'tools','doctrine_engage.py'); sys.exit(subprocess.call([sys.executable,p]) if os.path.exists(p) else 0)\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR',''),'tools','doctrine_guard.py'); sys.exit(subprocess.call([sys.executable,p]) if os.path.exists(p) else 0)\""
          }
        ]
      }
    ]
  }
}
