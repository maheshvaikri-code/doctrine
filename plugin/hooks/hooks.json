{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys; sys.exit(subprocess.call([sys.executable,'tools/doctrine_state.py','hydrate','--if-present']) if os.path.exists('tools/doctrine_state.py') else 0)\""
          },
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys; sys.exit(subprocess.call([sys.executable,'tools/doctrine_metrics.py','capture-hint']) if os.path.exists('tools/doctrine_metrics.py') else 0)\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys; sys.exit(subprocess.call([sys.executable,'tools/doctrine_engage.py']) if os.path.exists('tools/doctrine_engage.py') else 0)\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,subprocess,sys; sys.exit(subprocess.call([sys.executable,'tools/doctrine_guard.py']) if os.path.exists('tools/doctrine_guard.py') else 0)\""
          }
        ]
      }
    ]
  }
}
